# Backend API Base URL
# - For Local Development: http://localhost:5000/api/v1
# - For Production (Separate Domain, e.g., Render/Railway API + Vercel Client):
#   VITE_API_BASE_URL="https://api.buoyantmedia.com/api/v1"
