{
  "plugins": [
    "react",
    "typescript",
    "import"
  ],
  "rules": {
    "eslint/no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "react/set-state-in-effect": "off",
    "react/incompatible-library": "off",
    "react/preserve-manual-memoization": "off",
    "react/immutability": "off",
    "react/refs": "off",
    "react/purity": "off"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/build/**",
    "**/node_modules/**",
    "**/oxlint_report.txt"
  ]
}