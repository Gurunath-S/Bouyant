# ==============================================================================
# Buoyant Media Server (Backend API) Environment Configuration
# ==============================================================================

# Server Port (Typically injected automatically by cloud platforms like Render/Railway/Heroku)
PORT=5000

# Environment Mode: 'production' | 'development' | 'test'
NODE_ENV=production

# Database Connection URL (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
# Example: postgresql://postgres:SecurePass123!@ep-xyz.us-east-1.aws.neon.tech/buoyant_media?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/buoyant_media?schema=public"

# Redis Connection URL (For distributed stall hold locks & caching)
# Example: redis://default:redispw@redis-12345.upstash.io:6379 or redis://localhost:6379
REDIS_URL="redis://USER:PASSWORD@HOST:6379"

# JWT Authentication Secrets (Generate long random strings for production)
JWT_SECRET="replace-with-a-long-random-production-secret"
JWT_EXPIRES_IN="1d"
REFRESH_TOKEN_SECRET="replace-with-a-different-long-random-production-secret"
REFRESH_TOKEN_EXPIRES_IN="7d"

# CORS Allowed Frontend Origin(s)
# Can be a single URL or comma-separated list of allowed origins (e.g. Vercel client + custom domain)
# Example: CLIENT_URL="https://buoyant-media.vercel.app,https://buoyantmedia.com"
CLIENT_URL="http://localhost:5173"

# Stall Reservation Temporary Hold Duration (in minutes)
STALL_HOLD_DURATION_MINUTES=10

# GSTIN Verification API Key (from gstinapi.in or custom provider)
GSTIN_API_KEY="replace-with-gstin-provider-api-key"

# Razorpay API credentials
RAZORPAY_API_KEY="replace-with-razorpay-key-id"
RAZORPAY_API_SECRET="replace-with-razorpay-key-secret"

# Meta WhatsApp Cloud API Configuration (Disabled by default until credentials are set)
WHATSAPP_ENABLED=false
WHATSAPP_API_VERSION="v20.0"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_TEMPLATE_LANGUAGE="en"

# Configurable Meta WhatsApp Approved Template Names
WHATSAPP_TEMPLATE_BOOKING_CREATED="booking_created"
WHATSAPP_TEMPLATE_PAYMENT_SUCCESS="payment_success"
WHATSAPP_TEMPLATE_BOOKING_CONFIRMED="booking_confirmed"
WHATSAPP_TEMPLATE_PAYMENT_FAILED="payment_failed"
WHATSAPP_TEMPLATE_BOOKING_EXPIRED="booking_expired"
WHATSAPP_TEMPLATE_INVOICE_GENERATED="invoice_generated"
WHATSAPP_TEMPLATE_ADMIN_ALERT="admin_alert"

