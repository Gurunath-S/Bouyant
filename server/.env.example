# ==============================================================================
# Buoyant Media Server (Backend API) Environment Configuration
# ==============================================================================

# Server Port (Typically injected automatically by cloud platforms like Render/Railway/Heroku)
PORT=5000

# Environment Mode: 'production' | 'development' | 'test'
NODE_ENV=production

# Database Connection URL (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
# Example: postgresql://postgres:SecurePass123!@ep-xyz.us-east-1.aws.neon.tech/buoyant_media?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/buoyant_media?schema=public"

# Redis Connection URL (For distributed stall hold locks & caching)
# Example: redis://default:redispw@redis-12345.upstash.io:6379 or redis://localhost:6379
REDIS_URL="redis://localhost:6379"

# JWT Authentication Secrets (Generate long random strings for production)
JWT_SECRET="super-secret-jwt-key-buoyant-media-2026-production"
JWT_EXPIRES_IN="1d"
REFRESH_TOKEN_SECRET="super-secret-refresh-key-buoyant-media-2026-production"
REFRESH_TOKEN_EXPIRES_IN="7d"

# CORS Allowed Frontend Origin(s)
# Can be a single URL or comma-separated list of allowed origins (e.g. Vercel client + custom domain)
# Example: CLIENT_URL="https://buoyant-media.vercel.app,https://buoyantmedia.com"
CLIENT_URL="http://localhost:5173"

# Stall Reservation Temporary Hold Duration (in minutes)
STALL_HOLD_DURATION_MINUTES=10

# GSTIN Verification API Key (from gstinapi.in or custom provider)
GSTIN_API_KEY="gak_72520b2801814cf88b44ed8ba5ae7e39"
