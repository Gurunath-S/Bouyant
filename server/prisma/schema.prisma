// Prisma Schema for Buoyant Media Exhibition Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  ADMIN
  SUPERADMIN
}

enum StallCategory {
  STANDARD
  PREMIUM
  CORNER
  ISLAND
}

enum StallStatus {
  AVAILABLE
  TEMPORARILY_HELD
  BOOKING_IN_PROGRESS
  PAYMENT_PENDING
  BOOKED_CONFIRMED
  BLOCKED
}

enum ExhibitionStatus {
  DRAFT
  PUBLISHED
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  INITIATED
  HELD
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum InvoiceStatus {
  ISSUED
  PAID
  VOID
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  name          String
  phone         String?
  role          UserRole       @default(CLIENT)
  companyId     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  company       Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  bookings      Booking[]
  payments      Payment[]
  notifications Notification[]

  @@index([email])
  @@index([companyId])
}

model Company {
  id             String      @id @default(uuid())
  companyCode    String      @unique
  name           String      
  contactPerson  String
  mobile         String      @unique
  email          String      @unique
  address        String
  city           String
  state          String
  pinCode        String     
  country        String      @default("Not Provided")
  gstNumber      String      @unique
  panNumber      String      @unique
  tanNumber      String      @unique
  industry       String      
  website        String?     
  remarks        String?     @default("Not Provided")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  users          User[]
  bookings       Booking[]
  invoices       Invoice[]
}

model Exhibition {
  id          String           @id @default(uuid())
  title       String
  slug        String           @unique
  description String
  venue       String
  city        String
  startDate   DateTime
  endDate     DateTime
  status      ExhibitionStatus @default(DRAFT)
  bannerUrl   String?
  totalStalls Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  floorPlans  FloorPlan[]
  bookings    Booking[]

  @@index([slug])
  @@index([status])
}

model FloorPlan {
  id            String      @id @default(uuid())
  exhibitionId  String
  name          String
  width         Int         @default(1200) // canvas width px/units
  height        Int         @default(800)  // canvas height px/units
  backgroundUrl String?
  gridColumns   Int         @default(20)
  gridRows      Int         @default(15)
  isPublished   Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  exhibition    Exhibition  @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  stalls        Stall[]

  @@index([exhibitionId])
}

model Stall {
  id            String        @id @default(uuid())
  floorPlanId   String
  stallNumber   String        // e.g. "A-101"
  name          String?
  category      StallCategory @default(STANDARD)
  price         Decimal       @db.Decimal(12, 2)
  areaSqFt      Float         @default(100.0)
  width         Float         @default(100.0)
  height        Float         @default(100.0)
  xPosition     Float         @default(0.0)
  yPosition     Float         @default(0.0)
  status        StallStatus   @default(AVAILABLE)
  heldUntil     DateTime?
  heldByUserId  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  floorPlan     FloorPlan     @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)
  bookings      Booking[]

  @@unique([floorPlanId, stallNumber])
  @@index([floorPlanId])
  @@index([status])
  @@index([heldUntil])
}

model Booking {
  id               String        @id @default(uuid())
  bookingReference String        @unique
  userId           String
  companyId        String
  exhibitionId     String
  stallId          String
  status           BookingStatus @default(INITIATED)
  totalAmount      Decimal       @db.Decimal(12, 2)
  taxAmount        Decimal       @db.Decimal(12, 2)
  grandTotal       Decimal       @db.Decimal(12, 2)
  expiresAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user             User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  company          Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  exhibition       Exhibition    @relation(fields: [exhibitionId], references: [id], onDelete: Restrict)
  stall            Stall         @relation(fields: [stallId], references: [id], onDelete: Restrict)
  payment          Payment?
  invoice          Invoice?

  @@index([bookingReference])
  @@index([userId])
  @@index([companyId])
  @@index([stallId])
  @@index([status])
}

model Payment {
  id               String        @id @default(uuid())
  paymentReference String        @unique
  bookingId        String        @unique
  userId           String
  amount           Decimal       @db.Decimal(12, 2)
  currency         String        @default("USD")
  status           PaymentStatus @default(PENDING)
  provider         String        @default("STRIPE_SIMULATOR")
  transactionId    String?       @unique
  paymentMethod    String?
  failureReason    String?
  paidAt           DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  booking          Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user             User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  invoice          Invoice?

  @@index([paymentReference])
  @@index([status])
  @@index([transactionId])
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  bookingId     String        @unique
  paymentId     String?       @unique
  companyId     String
  totalAmount   Decimal       @db.Decimal(12, 2)
  taxAmount     Decimal       @db.Decimal(12, 2)
  grandTotal    Decimal       @db.Decimal(12, 2)
  pdfUrl        String?
  status        InvoiceStatus @default(ISSUED)
  issueDate     DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  payment       Payment?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([invoiceNumber])
  @@index([companyId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO") // INFO, SUCCESS, WARNING, DANGER
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
